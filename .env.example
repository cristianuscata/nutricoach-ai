# =============================================================
# NutriCoach — Archivo .env único para todo el proyecto
# Copia este archivo a .env y completa las credenciales reales.
# NUNCA subas .env a git (ya está en .gitignore).
# =============================================================

# ── OpenAI ────────────────────────────────────────────────────
OPENAI_API_KEY=sk-proj-replace-me

# ── Tools ─────────────────────────────────────────────────────
TAVILY_API_KEY=tvly-replace-me
USDA_API_KEY=DEMO_KEY          # DEMO_KEY funciona con rate limit; pon tu clave real si tienes

# ── Firebase ──────────────────────────────────────────────────
GOOGLE_APPLICATION_CREDENTIALS=./firebase-service-account.json
FIREBASE_PROJECT_ID=tu-project-id-aqui

# ── CORS (backend) ────────────────────────────────────────────
# En desarrollo solo localhost:5173
# En producción agrega la URL de Firebase Hosting (comma-separated)
CORS_ORIGINS=http://localhost:5173

# ── Frontend / Vite ───────────────────────────────────────────
# En desarrollo déjalo vacío → el proxy de Vite maneja /api → localhost:8000
# En producción pon la URL pública de Cloud Run:
# VITE_API_BASE=https://nutricoach-backend-xxxx-uc.a.run.app
VITE_API_BASE=

# ── Logging ───────────────────────────────────────────────────
LOG_LEVEL=INFO
